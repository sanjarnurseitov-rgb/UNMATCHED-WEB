# ---------------------------------------------------------------------------
# Unmatched Tracker — environment configuration
#
# The app is READ-ONLY: it never writes to the spreadsheet. Everything below
# is optional — with no configuration at all the app reads the table through
# the public CSV export (the sheet must be shared "anyone with the link").
# ---------------------------------------------------------------------------

# Your spreadsheet ID (the long id in the /d/<ID>/ URL)
GOOGLE_SHEETS_SPREADSHEET_ID=15IJy050me3WkkI2vYf10tMhCFCKF0dglRY_HaBF96vQ

# --- OPTIONAL: service account (faster reads, or a private sheet) ---------
# Option A: paste the whole service-account JSON (single line, \n escaped)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: or provide the three fields separately
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional overrides ----------------------------------------------------
# Tab ids are resolved automatically via the Sheets API when credentials are
# present; these ids are used for the credential-free public-CSV read mode.
SHEETS_TAB_MATCHES_GID=760832699
SHEETS_TAB_LISTS_GID=1236097987

# Tab that holds the image URLs: Имя | Тип (hero / player / Map) | URL
SHEETS_TAB_IMAGES=IMAGES

# Numeric id of that tab — optional, the app can read it by name without it
SHEETS_TAB_IMAGES_GID=

# Force a specific data source: auto | api | public | snapshot
# auto = api when credentials exist, otherwise public, otherwise snapshot
DATA_SOURCE=auto

# Background artwork of the app. Either a path in /public (e.g. /background.jpg)
# or an absolute URL. Leave empty to use the bundled public/background.jpg.
NEXT_PUBLIC_BACKGROUND_IMAGE=
